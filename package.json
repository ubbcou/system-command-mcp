{
  "name": "system-command-mcp",
  "version": "0.1.0",
  "description": "Cross-platform system command execution MCP server",
  "type": "module",
  "bin": {
    "system-command-mcp": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "AGENTS.md",
    "DSH.md",
    "!scripts",
    "!acceptance",
    "!docs/acceptance-windows-x64.json",
    "system-command-manifest.schema.json",
    "system-command-manifest.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node scripts/test.mjs",
    "acceptance:runtime-portable": "npm run build && node scripts/integration/acceptance-runtime-portable.mjs",
    "acceptance:portable": "npm run build && node scripts/integration/acceptance-portable.mjs",
    "acceptance:dsh": "node scripts/integration/dsh-mcp-smoke.mjs",
    "acceptance:dsh-reconnect": "node scripts/integration/dsh-mcp-reconnect-smoke.mjs",
    "acceptance:codex-real-host": "node scripts/integration/codex-real-host-evidence.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cross-spawn": "^7.0.6",
    "koffi": "^2.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
